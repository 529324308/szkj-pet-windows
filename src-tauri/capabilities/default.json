{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "桌宠窗口所需的最小能力：拖窗与事件通道。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:event:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://zjshuzhi.cn:8090/*" },
        { "url": "https://zjshuzhi.cn:8084/*" },
        { "url": "https://zjshuzhi.cn:1434/api/chat/*" },
        { "url": "https://zjshuzhi.cn:1435/api/chat/*" }
      ]
    }
  ]
}
